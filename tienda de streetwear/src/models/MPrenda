export abstract class MPrenda {
    protected _codigo: number;
    protected _marca: string;
    protected _costo: number;

    constructor({    
        codigo,  //es un codigo
        marca,
        costo
    }: {
        codigo: number,
        marca: string,
        costo: number
    }) {
        this._codigo = +codigo;
        this._marca = marca.trim();
        this._costo = +costo;
    }

    protected precioinicial(): number {
        return this._costo + (this._costo * 0.3);
    }

    abstract preciofinal(): number;


    set codigo(codigo: number) {
        this._codigo = +codigo;
    } 

    get codigo(): number {
        return this._codigo;
    }

    set marca(marca: string) {
        this._marca = marca.trim();
    }

    get marca(): string {
        return this._marca;
    }
    set costo(costo: number) {
        this._costo = +costo;
    }

    get costo(): number {
        return this._costo;
    }
}